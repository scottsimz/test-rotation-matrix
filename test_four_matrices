%% ============================================================
%  TEST SUITE AND VISUAL COMPARISON
%
%  R1  ENU / RPY  body -> ENU  active   Ry(r)*Rx(p)*Rz(y)
%  R2  NED / YPR  NED  -> body passive  [Rz(y)*Ry(p)*Rx(r)]'
%  R3  NED / RPY  body -> NED  active   Rx(r)*Ry(p)*Rz(y)
%  R4  ENU / YPR  ENU  -> body passive  [Rz(y)*Rx(p)*Ry(r)]'
%
%  Visualization goal:
%  -------------------
%  Plot all four rotations in the SAME ENU plotting frame:
%
%       x-axis = East
%       y-axis = North
%       z-axis = Up
%
%  For NED-native matrices R2 and R3, vectors are converted from NED
%  coordinates into ENU coordinates before plotting.
%
%  For active matrices:
%       columns of R = body axes expressed in reference frame.
%
%  For passive matrices:
%       rows of R = body axes expressed in reference frame.
%
% ============================================================

clear;
close all;
clc;

rng(1);

d2r = pi / 180;
TOL = 1e-12;

%% ============================================================
%  Elementary rotations
% ============================================================

c = @cos;
s = @sin;

Rx = @(a) [ ...
    1,     0,      0;
    0,  c(a),  -s(a);
    0,  s(a),   c(a)];

Ry = @(a) [ ...
     c(a), 0, s(a);
        0, 1,    0;
    -s(a), 0, c(a)];

Rz = @(a) [ ...
    c(a), -s(a), 0;
    s(a),  c(a), 0;
       0,     0, 1];

%% ============================================================
%  ENU/NED conversion
% ============================================================

% Converts a vector expressed in NED coordinates into ENU coordinates.
%
% NED = [N; E; D]
% ENU = [E; N; U]
%
% Therefore:
%     E = NED_y
%     N = NED_x
%     U = -NED_z

C_NED_to_ENU = [ ...
    0  1  0;
    1  0  0;
    0  0 -1];

%% ============================================================
%  Matrix definitions
% ============================================================

% R1  ENU/RPY  active body -> ENU
R1 = @(r,p,y) [ ...
    c(r)*c(y)+s(r)*s(p)*s(y), -c(r)*s(y)+s(r)*s(p)*c(y),  s(r)*c(p);
    c(p)*s(y),                 c(p)*c(y),                -s(p);
   -s(r)*c(y)+c(r)*s(p)*s(y), s(r)*s(y)+c(r)*s(p)*c(y),  c(r)*c(p)];

% R2  NED/YPR  passive NED -> body
R2 = @(r,p,y) [ ...
    c(p)*c(y),                  c(p)*s(y),                -s(p);
    s(r)*s(p)*c(y)-c(r)*s(y),  s(r)*s(p)*s(y)+c(r)*c(y), s(r)*c(p);
    c(r)*s(p)*c(y)+s(r)*s(y),  c(r)*s(p)*s(y)-s(r)*c(y), c(r)*c(p)];

% R3  NED/RPY  active body -> NED
R3 = @(r,p,y) [ ...
    c(p)*c(y),                 -c(p)*s(y),                 s(p);
    c(r)*s(y)+s(r)*s(p)*c(y),  c(r)*c(y)-s(r)*s(p)*s(y), -s(r)*c(p);
    s(r)*s(y)-c(r)*s(p)*c(y),  s(r)*c(y)+c(r)*s(p)*s(y),  c(r)*c(p)];

% R4  ENU/YPR  passive ENU -> body
R4 = @(r,p,y) [ ...
    c(r)*c(y)-s(r)*s(p)*s(y),  c(r)*s(y)+s(r)*s(p)*c(y), -s(r)*c(p);
   -c(p)*s(y),                  c(p)*c(y),                 s(p);
    s(r)*c(y)+c(r)*s(p)*s(y),  s(r)*s(y)-c(r)*s(p)*c(y),  c(r)*c(p)];

%% ============================================================
%  Test configurations for visualization
% ============================================================

tests = { ...
    'Pure yaw y=+30',        0*d2r,  0*d2r, 30*d2r;
    'Pure pitch p=+30',      0*d2r, 30*d2r,  0*d2r;
    'Pure roll r=+30',      30*d2r,  0*d2r,  0*d2r;
    'General case',         10*d2r, 20*d2r, 30*d2r
};

Nc = size(tests,1);

%% ============================================================
%  TEST 0 — DIRECT PRODUCT DEFINITIONS
% ============================================================

printHeader('TEST 0 — DIRECT PRODUCT DEFINITIONS');

for k = 1:Nc

    r = tests{k,2};
    p = tests{k,3};
    y = tests{k,4};

    M1_expected = Ry(r) * Rx(p) * Rz(y);
    M2_expected = (Rz(y) * Ry(p) * Rx(r))';
    M3_expected = Rx(r) * Ry(p) * Rz(y);
    M4_expected = (Rz(y) * Rx(p) * Ry(r))';

    report(['R1 product check: ' tests{k,1}], ...
        norm(R1(r,p,y) - M1_expected, 'fro'), TOL);

    report(['R2 product check: ' tests{k,1}], ...
        norm(R2(r,p,y) - M2_expected, 'fro'), TOL);

    report(['R3 product check: ' tests{k,1}], ...
        norm(R3(r,p,y) - M3_expected, 'fro'), TOL);

    report(['R4 product check: ' tests{k,1}], ...
        norm(R4(r,p,y) - M4_expected, 'fro'), TOL);

end

%% ============================================================
%  TEST 1 — IDENTITY
% ============================================================

printHeader('TEST 1 — IDENTITY');

report('R1(0,0,0) = I', norm(R1(0,0,0) - eye(3), 'fro'), TOL);
report('R2(0,0,0) = I', norm(R2(0,0,0) - eye(3), 'fro'), TOL);
report('R3(0,0,0) = I', norm(R3(0,0,0) - eye(3), 'fro'), TOL);
report('R4(0,0,0) = I', norm(R4(0,0,0) - eye(3), 'fro'), TOL);

%% ============================================================
%  TEST 2 — SO(3) MEMBERSHIP
% ============================================================

printHeader('TEST 2 — SO(3) MEMBERSHIP');

Nr = 1000;
margin = 1e-3;

rv = -pi + 2*pi*rand(Nr,1);
pv = -pi/2 + margin + (pi - 2*margin)*rand(Nr,1);
yv = -pi + 2*pi*rand(Nr,1);

maxErr1 = 0;
maxErr2 = 0;
maxErr3 = 0;
maxErr4 = 0;

for k = 1:Nr

    M1 = R1(rv(k), pv(k), yv(k));
    M2 = R2(rv(k), pv(k), yv(k));
    M3 = R3(rv(k), pv(k), yv(k));
    M4 = R4(rv(k), pv(k), yv(k));

    maxErr1 = max(maxErr1, max(norm(M1*M1' - eye(3), 'fro'), abs(det(M1)-1)));
    maxErr2 = max(maxErr2, max(norm(M2*M2' - eye(3), 'fro'), abs(det(M2)-1)));
    maxErr3 = max(maxErr3, max(norm(M3*M3' - eye(3), 'fro'), abs(det(M3)-1)));
    maxErr4 = max(maxErr4, max(norm(M4*M4' - eye(3), 'fro'), abs(det(M4)-1)));

end

report('R1 random SO(3) membership', maxErr1, TOL);
report('R2 random SO(3) membership', maxErr2, TOL);
report('R3 random SO(3) membership', maxErr3, TOL);
report('R4 random SO(3) membership', maxErr4, TOL);

%% ============================================================
%  VISUALIZATION
%
%  All figures use the same ENU plotting frame:
%
%       x = East
%       y = North
%       z = Up
%
% ============================================================

bclr = {'r','g','b'};
blab = {'body-x','body-y','body-z'};

%% ------------------------------------------------------------
%  FIGURE 1 — R1
%
%  R1 is active body -> ENU.
%  Columns of R1 are body axes expressed in ENU.
%% ------------------------------------------------------------

figure('Name','R1 Body Axes in ENU','Color','w');

for k = 1:Nc

    r = tests{k,2};
    p = tests{k,3};
    y = tests{k,4};

    M1 = R1(r,p,y);

    bodyAxesENU = M1;

    subplot(1,Nc,k);

    plotBodyAxesENU(bodyAxesENU, ...
        tests{k,1}, r, p, y, d2r, bclr, blab);

end

sgtitle('R1 (ENU/RPY) — Body Axes Expressed in Common ENU Frame');

%% ------------------------------------------------------------
%  FIGURE 2 — R2
%
%  R2 is passive NED -> body.
%  Rows of R2 are body axes expressed in NED.
%  Convert each body axis from NED into ENU before plotting.
%% ------------------------------------------------------------

figure('Name','R2 Body Axes Converted to ENU','Color','w');

for k = 1:Nc

    r = tests{k,2};
    p = tests{k,3};
    y = tests{k,4};

    M2 = R2(r,p,y);

    bodyAxesNED = M2';
    bodyAxesENU = C_NED_to_ENU * bodyAxesNED;

    subplot(1,Nc,k);

    plotBodyAxesENU(bodyAxesENU, ...
        tests{k,1}, r, p, y, d2r, bclr, blab);

end

sgtitle('R2 (NED/YPR Passive) — Body Axes Converted to Common ENU Frame');

%% ------------------------------------------------------------
%  FIGURE 3 — R3
%
%  R3 is active body -> NED.
%  Columns of R3 are body axes expressed in NED.
%  Convert each body axis from NED into ENU before plotting.
%% ------------------------------------------------------------

figure('Name','R3 Body Axes Converted to ENU','Color','w');

for k = 1:Nc

    r = tests{k,2};
    p = tests{k,3};
    y = tests{k,4};

    M3 = R3(r,p,y);

    bodyAxesNED = M3;
    bodyAxesENU = C_NED_to_ENU * bodyAxesNED;

    subplot(1,Nc,k);

    plotBodyAxesENU(bodyAxesENU, ...
        tests{k,1}, r, p, y, d2r, bclr, blab);

end

sgtitle('R3 (NED/RPY Active) — Body Axes Converted to Common ENU Frame');

%% ------------------------------------------------------------
%  FIGURE 4 — R4
%
%  R4 is passive ENU -> body.
%  Rows of R4 are body axes expressed in ENU.
%% ------------------------------------------------------------

figure('Name','R4 Body Axes in ENU','Color','w');

for k = 1:Nc

    r = tests{k,2};
    p = tests{k,3};
    y = tests{k,4};

    M4 = R4(r,p,y);

    bodyAxesENU = M4';

    subplot(1,Nc,k);

    plotBodyAxesENU(bodyAxesENU, ...
        tests{k,1}, r, p, y, d2r, bclr, blab);

end

sgtitle('R4 (ENU/YPR Passive) — Body Axes Expressed in Common ENU Frame');

%% ============================================================
%  LOCAL FUNCTIONS
% ============================================================

function plotBodyAxesENU(bodyAxesENU, titleStr, r, p, y, d2r, bclr, blab)

hold on;
grid on;
box on;
axis equal;

% Common ENU plotting convention:
% x = East
% y = North
% z = Up

xlabel('East');
ylabel('North');
zlabel('Up');

axis([-1.25 1.25 -1.25 1.25 -1.25 1.25]);

view(35,22);

% Plot reference ENU axes in gray.

refLength = 0.45;

quiver3(0,0,0, refLength,0,0, ...
    'Color',[0.65 0.65 0.65], ...
    'LineWidth',1.0, ...
    'AutoScale','off');

text(1.15*refLength,0,0,'E', ...
    'Color',[0.45 0.45 0.45], ...
    'FontWeight','bold');

quiver3(0,0,0, 0,refLength,0, ...
    'Color',[0.65 0.65 0.65], ...
    'LineWidth',1.0, ...
    'AutoScale','off');

text(0,1.15*refLength,0,'N', ...
    'Color',[0.45 0.45 0.45], ...
    'FontWeight','bold');

quiver3(0,0,0, 0,0,refLength, ...
    'Color',[0.65 0.65 0.65], ...
    'LineWidth',1.0, ...
    'AutoScale','off');

text(0,0,1.15*refLength,'U', ...
    'Color',[0.45 0.45 0.45], ...
    'FontWeight','bold');

% Plot rotated body axes.
%
% bodyAxesENU(:,1) = body-x expressed in ENU
% bodyAxesENU(:,2) = body-y expressed in ENU
% bodyAxesENU(:,3) = body-z expressed in ENU

for j = 1:3

    v = bodyAxesENU(:,j);

    quiver3(0,0,0, ...
        v(1), v(2), v(3), ...
        'Color', bclr{j}, ...
        'LineWidth', 2.5, ...
        'AutoScale', 'off');

    text(1.12*v(1), 1.12*v(2), 1.12*v(3), ...
        blab{j}, ...
        'Color', bclr{j}, ...
        'FontWeight','bold');

end

title({titleStr, ...
      sprintf('r=%+.0f deg, p=%+.0f deg, y=%+.0f deg', ...
      r/d2r, p/d2r, y/d2r)}, ...
      'FontSize',8);

end

function printHeader(titleStr)

bar = repmat('=',1,60);

fprintf('\n%s\n', bar);
fprintf('%s\n', titleStr);
fprintf('%s\n', bar);

end

function report(label, err, tol)

if err <= tol

    tag = 'PASS';

else

    tag = '*** FAIL ***';

end

fprintf('  %-42s err = %.3e [%s]\n', ...
    label, err, tag);

if err > tol
    error('Test failed: %s', label);
end

end
