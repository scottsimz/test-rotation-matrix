%% ============================================================
%  TEST SUITE — R3 (NED / RPY)  and  R4 (ENU / YPR)
%
%  PURPOSE
%  -------
%  Verify expanded rotation matrices against:
%
%     (1) Their direct elementary-product definitions
%     (2) SO(3) membership
%     (3) Single-axis reductions
%     (4) Angle round-trip recovery
%     (5) Gimbal-lock behavior
%
%  IMPORTANT CONVENTION WARNING
%  ----------------------------
%  R1 / R4:
%       r -> rotation about Y-axis
%       p -> rotation about X-axis
%
%  R3:
%       r -> rotation about X-axis
%       p -> rotation about Y-axis
%
%  Therefore, the meaning of "roll" and "pitch" differs between
%  the ENU and NED families unless this relabeling is intentional.
%
%  MATRIX DEFINITIONS
%  ------------------
%
%    R1  ENU / RPY  body→ENU  active   Ry(r)*Rx(p)*Rz(y)
%    R2  NED / YPR  NED→body  passive  [Rz(y)*Ry(p)*Rx(r)]'
%
%    R3  NED / RPY  body→NED  active   Rx(r)*Ry(p)*Rz(y)
%    R4  ENU / YPR  ENU→body  passive  [Rz(y)*Rx(p)*Ry(r)]'
%
% ============================================================

clear;
close all;
clc;

rng(1);

d2r = pi / 180;
TOL = 1e-12;

%% ============================================================
%  Elementary rotations
% ============================================================

c = @cos;
s = @sin;

Rx = @(a) [ ...
    1,     0,      0;
    0,  c(a),  -s(a);
    0,  s(a),   c(a)];

Ry = @(a) [ ...
     c(a), 0, s(a);
        0, 1,    0;
    -s(a), 0, c(a)];

Rz = @(a) [ ...
    c(a), -s(a), 0;
    s(a),  c(a), 0;
       0,     0, 1];

%% ============================================================
%  Matrix definitions
% ============================================================

% R1  ENU/RPY  active body→ENU
R1 = @(r,p,y) [ ...
    c(r)*c(y)+s(r)*s(p)*s(y), -c(r)*s(y)+s(r)*s(p)*c(y),  s(r)*c(p);
    c(p)*s(y),                 c(p)*c(y),                -s(p);
   -s(r)*c(y)+c(r)*s(p)*s(y), s(r)*s(y)+c(r)*s(p)*c(y),  c(r)*c(p)];

% R2  NED/YPR  passive NED→body
R2 = @(r,p,y) [ ...
    c(p)*c(y),                  c(p)*s(y),                -s(p);
    s(r)*s(p)*c(y)-c(r)*s(y),  s(r)*s(p)*s(y)+c(r)*c(y), s(r)*c(p);
    c(r)*s(p)*c(y)+s(r)*s(y),  c(r)*s(p)*s(y)-s(r)*c(y), c(r)*c(p)];

% R3  NED/RPY  active body→NED
R3 = @(r,p,y) [ ...
    c(p)*c(y),                 -c(p)*s(y),                 s(p);
    c(r)*s(y)+s(r)*s(p)*c(y),  c(r)*c(y)-s(r)*s(p)*s(y), -s(r)*c(p);
    s(r)*s(y)-c(r)*s(p)*c(y),  s(r)*c(y)+c(r)*s(p)*s(y),  c(r)*c(p)];

% R4  ENU/YPR  passive ENU→body
R4 = @(r,p,y) [ ...
    c(r)*c(y)-s(r)*s(p)*s(y),  c(r)*s(y)+s(r)*s(p)*c(y), -s(r)*c(p);
   -c(p)*s(y),                  c(p)*c(y),                 s(p);
    s(r)*c(y)+c(r)*s(p)*s(y),  s(r)*s(y)-c(r)*s(p)*c(y),  c(r)*c(p)];

%% ============================================================
%  Test configurations
% ============================================================

tests = { ...
    'Zero attitude',          0*d2r,  0*d2r,   0*d2r;
    'Pure yaw y=+90',         0*d2r,  0*d2r,  90*d2r;
    'Pure pitch p=+30',       0*d2r, 30*d2r,   0*d2r;
    'Pure roll r=+45',       45*d2r,  0*d2r,   0*d2r;
    'General case',          20*d2r, 15*d2r,  45*d2r
};

Nc = size(tests,1);

%% ============================================================
%  TEST 0 — DIRECT PRODUCT DEFINITIONS
% ============================================================

printHeader('TEST 0 — DIRECT PRODUCT DEFINITIONS');

for k = 1:Nc

    r = tests{k,2};
    p = tests{k,3};
    y = tests{k,4};

    M3_expected = Rx(r) * Ry(p) * Rz(y);
    M4_expected = (Rz(y) * Rx(p) * Ry(r))';

    err3 = norm(R3(r,p,y) - M3_expected, 'fro');
    err4 = norm(R4(r,p,y) - M4_expected, 'fro');

    report(['R3 product check: ' tests{k,1}], err3, TOL);
    report(['R4 product check: ' tests{k,1}], err4, TOL);

end

%% ============================================================
%  TEST 1 — IDENTITY
% ============================================================

printHeader('TEST 1 — IDENTITY');

report('R3(0,0,0) = I', ...
    norm(R3(0,0,0) - eye(3), 'fro'), TOL);

report('R4(0,0,0) = I', ...
    norm(R4(0,0,0) - eye(3), 'fro'), TOL);

%% ============================================================
%  TEST 2 — SO(3) MEMBERSHIP
% ============================================================

printHeader('TEST 2 — SO(3) MEMBERSHIP');

Nr = 1000;

margin = 1e-3;

rv = -pi + 2*pi*rand(Nr,1);

pv = -pi/2 + margin + (pi - 2*margin)*rand(Nr,1);

yv = -pi + 2*pi*rand(Nr,1);

maxErr3 = 0;
maxErr4 = 0;

for k = 1:Nr

    M3 = R3(rv(k), pv(k), yv(k));
    M4 = R4(rv(k), pv(k), yv(k));

    err3 = max( ...
        norm(M3*M3' - eye(3), 'fro'), ...
        abs(det(M3)-1));

    err4 = max( ...
        norm(M4*M4' - eye(3), 'fro'), ...
        abs(det(M4)-1));

    maxErr3 = max(maxErr3, err3);
    maxErr4 = max(maxErr4, err4);

end

report('R3 random SO(3) membership', maxErr3, TOL);
report('R4 random SO(3) membership', maxErr4, TOL);

%% ============================================================
%  TEST 3 — SINGLE-AXIS REDUCTIONS
% ============================================================

printHeader('TEST 3 — SINGLE-AXIS REDUCTIONS');

a = 37*d2r;

report('R3(r,0,0) = Rx(r)', ...
    norm(R3(a,0,0) - Rx(a), 'fro'), TOL);

report('R3(0,p,0) = Ry(p)', ...
    norm(R3(0,a,0) - Ry(a), 'fro'), TOL);

report('R3(0,0,y) = Rz(y)', ...
    norm(R3(0,0,a) - Rz(a), 'fro'), TOL);

report('R4(r,0,0) = Ry(-r)', ...
    norm(R4(a,0,0) - Ry(-a), 'fro'), TOL);

report('R4(0,p,0) = Rx(-p)', ...
    norm(R4(0,a,0) - Rx(-a), 'fro'), TOL);

report('R4(0,0,y) = Rz(-y)', ...
    norm(R4(0,0,a) - Rz(-a), 'fro'), TOL);

%% ============================================================
%  TEST 4 — BASIS VECTOR MAPPING
% ============================================================

printHeader('TEST 4 — BASIS VECTOR MAPPING');

ex = [1;0;0];
ey = [0;1;0];
ez = [0;0;1];

M = R3(0,0,90*d2r);

report('R3 yaw+90: body-x -> +Y', ...
    norm(M*ex - ey), TOL);

report('R3 yaw+90: body-y -> -X', ...
    norm(M*ey + ex), TOL);

%% ============================================================
%  TEST 5 — ROUND-TRIP RECOVERY
% ============================================================

printHeader('TEST 5 — ROUND-TRIP RECOVERY');

Nr = 1000;

for k = 1:Nr

    r0 = -pi + 2*pi*rand;
    p0 = -pi/2 + margin + (pi - 2*margin)*rand;
    y0 = -pi + 2*pi*rand;

    %% ---- R3 ----

    M3 = R3(r0,p0,y0);

    p3 = asin(clamp(M3(1,3)));

    y3 = atan2(-M3(1,2), M3(1,1));

    r3 = atan2(-M3(2,3), M3(3,3));

    err3 = norm(wrapToPiLocal([r3-r0, p3-p0, y3-y0]));

    if err3 > 1e-10
        error('R3 round-trip failed at k=%d  err=%g', k, err3);
    end

    %% ---- R4 ----

    M4 = R4(r0,p0,y0);

    p4 = asin(clamp(M4(2,3)));

    y4 = atan2(-M4(2,1), M4(2,2));

    r4 = atan2(-M4(1,3), M4(3,3));

    err4 = norm(wrapToPiLocal([r4-r0, p4-p0, y4-y0]));

    if err4 > 1e-10
        error('R4 round-trip failed at k=%d  err=%g', k, err4);
    end

end

fprintf('  R3 random round-trip: PASS\n');
fprintf('  R4 random round-trip: PASS\n');

%% ============================================================
%  TEST 6 — GIMBAL LOCK
% ============================================================

printHeader('TEST 6 — GIMBAL LOCK');

r_g = 20*d2r;
y_g = 45*d2r;

for p_g = [90, -90] * d2r

    fprintf('\n  p = %+0.1f deg\n', p_g/d2r);

    M3 = R3(r_g, p_g, y_g);

    orth3 = norm(M3*M3' - eye(3), 'fro');
    det3  = abs(det(M3)-1);

    fprintf('    R3 orthogonality = %.3e\n', orth3);
    fprintf('    R3 determinant   = %.3e\n', det3);

    M4 = R4(r_g, p_g, y_g);

    orth4 = norm(M4*M4' - eye(3), 'fro');
    det4  = abs(det(M4)-1);

    fprintf('    R4 orthogonality = %.3e\n', orth4);
    fprintf('    R4 determinant   = %.3e\n', det4);

end

fprintf('\n');
fprintf('  Rotation matrices remain in SO(3) at gimbal lock.\n');
fprintf('  Roll and yaw become coupled at the singularity.\n');

%% ============================================================
%  VISUALIZATION
% ============================================================

bclr = {'r','g','b'};
blab = {'body-x','body-y','body-z'};

figure('Name','R3 Body Axes in NED','Color','w');

for k = 1:Nc

    r = tests{k,2};
    p = tests{k,3};
    y = tests{k,4};

    M3 = R3(r,p,y);

    subplot(1,Nc,k);
    hold on;
    grid on;
    axis equal;

    set(gca,'ZDir','reverse');

    for j = 1:3

        v = M3(:,j);

        quiver3(0,0,0, ...
            v(1), v(2), v(3), ...
            'Color', bclr{j}, ...
            'LineWidth', 2, ...
            'AutoScale', 'off');

        text(v(1)*1.1, v(2)*1.1, v(3)*1.1, ...
            blab{j}, ...
            'Color', bclr{j});

    end

    xlabel('N');
    ylabel('E');
    zlabel('D');

    axis([-1.2 1.2 -1.2 1.2 -1.2 1.2]);

    title(tests{k,1});

    view(35,22);

end

sgtitle('R3 (NED/RPY)');

%% ============================================================
%  LOCAL FUNCTIONS
% ============================================================

function printHeader(titleStr)

bar = repmat('=',1,60);

fprintf('\n%s\n', bar);
fprintf('%s\n', titleStr);
fprintf('%s\n', bar);

end

function report(label, err, tol)

if err <= tol

    tag = 'PASS';

else

    tag = '*** FAIL ***';

end

fprintf('  %-42s err = %.3e [%s]\n', ...
    label, err, tag);

if err > tol
    error('Test failed: %s', label);
end

end

function x = clamp(x)

x = max(-1, min(1, x));

end

function a = wrapToPiLocal(a)

a = mod(a + pi, 2*pi) - pi;

end